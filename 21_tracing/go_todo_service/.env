# Server Configuration
SERVER_HOST=localhost
SERVER_PORT=8080
SERVER_GRPC_PORT=50051
SERVER_READ_TIMEOUT=10
SERVER_WRITE_TIMEOUT=10
SERVER_SHUTDOWN_TIMEOUT=5
GIN_MODE=debug
GRPC_REFLECTION_ENABLED=true

# Database Configuration
# These credentials match the PostgreSQL service in compose.yaml.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=todo_db
DB_SSLMODE=disable

# Database Connection Pool
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100

# Logging Configuration
LOG_LEVEL=info                    # debug, info, warn, error, fatal
LOG_FORMAT=json                   # json or text
LOG_FILENAME=logs/app.log         # empty value means stdout only
LOG_MAX_SIZE=100                  # MB
LOG_MAX_AGE=30                    # days
LOG_MAX_BACKUPS=5
LOG_COMPRESS=true
LOG_LOCAL_TIME=true
LOG_ROTATE_DAILY=false
LOG_ENABLE_STDOUT=false

# Tracing Configuration (OpenTelemetry -> Collector -> Jaeger)
TRACE_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SERVICE_NAME=go-todo-service
SERVICE_VERSION=1.0.0
DEPLOYMENT_ENVIRONMENT=development
TRACE_SAMPLE_RATIO=1

# Reserved switch from wip/12-app. The current implementation does not yet
# read this variable; keep it for the HTTP-body tracing feature.
TRACE_HTTP_BODY_ENABLED=true
